// ============================================================================
// Case 2: every query I ran, in order.
//
// Run them in: Azure portal > Microsoft Sentinel > your workspace > Logs (KQL mode).
// The data comes from the SecurityEvent table, which only fills once the Windows VM is
// connected through "Windows Security Events via AMA" (see ../lab-setup/04-windows-vm-and-agent.md).
// My run was on 2026-10-20 (UTC). Change the datetime(...) values to your own run.
//
// Event IDs used here:
//   4688 = a process was created (needs the "command line" setting turned on)
//   4698 = a scheduled task was created     4699 = a scheduled task was deleted
//   4720 = a user account was created       4726 = a user account was deleted
//   4732 = member added to a local group    4733 = member removed from a local group
//   4624 = a logon (LogonType 10 = remote desktop, 3 = network, 5 = service)
// ============================================================================


// ---- 1. Is the agent talking to the workspace? -----------------------------
// If this is empty, nothing else will work. Check the agent first.
Heartbeat
| where Computer has "win-endpoint01"
| summarize Last = max(TimeGenerated), Beats = count() by Category


// ---- 2. Is Security data arriving? -----------------------------------------
// First time I ran this it said "No results". It was just ingestion delay. Wait 10-20 minutes.
SecurityEvent
| summarize Events = count(), Earliest = min(TimeGenerated), Latest = max(TimeGenerated) by EventID
| order by Events desc


// ---- 3. The baseline: normal admin activity before the attack --------------
SecurityEvent
| where EventID in (4688, 4698)
| where TimeGenerated > ago(1h)
| project TimeGenerated, EventID, Account, NewProcessName, CommandLine
| order by TimeGenerated asc
// You will see a lot of noise from WORKGROUP\win-endpoint01$ (the machine itself) and the
// Azure Monitor Agent. The interesting rows are the ones from win-endpoint01\labadmin.


// ---- 4. The attack timeline, noise removed ---------------------------------
SecurityEvent
| where TimeGenerated > datetime(2026-10-20 22:23)
| where EventID in (4688, 4698, 4720, 4732)
| where Account !startswith "WORKGROUP"
| project TimeGenerated, EventID, Account, ParentProcessName, NewProcessName, CommandLine, TargetUserName, MemberName
| order by TimeGenerated asc


// ---- 5. The suspicious command lines in full -------------------------------
// Click a row and open CommandLine to read the whole thing.
SecurityEvent
| where TimeGenerated > datetime(2026-10-20 22:23)
| where EventID == 4688 and Account !startswith "WORKGROUP"
| where CommandLine has_any ("-Enc", "schtasks", "reg", "net user", "net localgroup")
| project TimeGenerated, ParentProcessName, CommandLine
| order by TimeGenerated asc
// Note: "net user" will not match "net.exe user ...", because the log has net.exe, not net.


// ---- 6. What was the scheduled task? ---------------------------------------
// FIRST VERSION: the EventData column is raw XML and hard to read.
SecurityEvent
| where EventID == 4698 and TimeGenerated > datetime(2026-10-20 22:00)
| project TimeGenerated, Account, EventData
| order by TimeGenerated asc

// SECOND VERSION: turn the XML into rows with the task name and task content.
SecurityEvent
| where EventID == 4698 and TimeGenerated > datetime(2026-10-20 22:00)
| extend x = parse_xml(EventData)
| mv-expand d = x.EventData.Data
| where tostring(d["@Name"]) in ("TaskName", "TaskContent")
| project TimeGenerated, Name = tostring(d["@Name"]), Value = tostring(d["#text"])
| order by TimeGenerated asc


// ---- 7. Did the persistence work? Check after a restart --------------------
// Two checks. Restart the VM and log in again first.
SecurityEvent
| where TimeGenerated > datetime(2026-10-20 22:30)
| summarize Events = count(), Latest = max(TimeGenerated) by EventID
| order by Events desc

SecurityEvent
| where TimeGenerated > datetime(2026-10-20 22:30)
| where EventID in (4688, 4624)
| where CommandLine has_any ("invoice_update", "-Enc") or EventID == 4624
| project TimeGenerated, EventID, Account, LogonType, ParentProcessName, NewProcessName, CommandLine
| order by TimeGenerated asc
// What I saw: SYSTEM ran the script 0.56 seconds after my RDP logon (the scheduled task),
// and labadmin ran it about 95 seconds later through explorer.exe (the Run key).


// ---- 8. Is the cleanup visible in the log? ---------------------------------
SecurityEvent
| where TimeGenerated > datetime(2026-10-20 22:35)
| where EventID in (4699, 4726, 4733) or (EventID == 4688 and CommandLine has_any ("schtasks", "reg", "net user", "net localgroup"))
| project TimeGenerated, EventID, Account, TargetUserName, CommandLine
| order by TimeGenerated asc


// ---- 9. After the second restart: did anything launch the script again? ----
SecurityEvent
| where TimeGenerated > datetime(2026-10-20 22:37)
| where EventID == 4688
| where CommandLine has_any ("invoice_update", "-Enc")
| project TimeGenerated, Account, ParentProcessName, CommandLine
| order by TimeGenerated asc
// "No results" here is what you want.

SecurityEvent
| where TimeGenerated > datetime(2026-10-20 22:36)
| where EventID == 4624 and LogonType in (10, 3) and Account has "labadmin"
| project TimeGenerated, EventID, Account, LogonType
| order by TimeGenerated asc
// This one gives the exact time I logged back in (22:37:51), which is what the
// "no results" above is measured against.


// ---- 10. The detection: encoded PowerShell followed by persistence ---------
// FIRST DRAFT FAILED to parse:
//   let from = datetime(...); let to = datetime(...);
//   -> "A syntax error ... Query could not be parsed at 'to'"
// "to" is a reserved word in KQL. Use tstart and tend instead.
//
// Test A (attack window): expect one row.     tstart 22:23, tend 22:30
// Test B (baseline window): expect no rows.   tstart 22:15, tend 22:22
// To run it as a real rule, use:  let tstart = ago(1h);  let tend = now();
let tstart = datetime(2026-10-20 22:23);
let tend = datetime(2026-10-20 22:30);
let encoded = SecurityEvent
    | where TimeGenerated between (tstart .. tend)
    | where EventID == 4688
    | where NewProcessName endswith "powershell.exe" or NewProcessName endswith "pwsh.exe"
    | where CommandLine has_any (" -enc ", " -ec ", " -encodedcommand ")
    | project EncTime = TimeGenerated, Computer, EncAccount = Account, EncParent = ParentProcessName;
let persistence = SecurityEvent
    | where TimeGenerated between (tstart .. tend)
    | where EventID in (4698, 4720)
        or (EventID == 4688 and CommandLine has_any ("schtasks", "reg ", "reg.exe") and CommandLine has_any ("/create", " add ", "CurrentVersion\\Run"))
    | project PersistTime = TimeGenerated, Computer, PersistEvent = EventID, PersistAccount = Account, PersistCmd = CommandLine;
encoded
| join kind=inner persistence on Computer
| where PersistTime between (EncTime .. (EncTime + 30m))
| summarize FirstEncoded = min(EncTime), FirstPersistence = min(PersistTime),
            PersistenceEvents = make_set(PersistEvent), Count = count() by Computer, EncAccount
